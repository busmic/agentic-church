# Supabase (optional). Leave both unset to run fully in-memory (great for local dev).
NEXT_PUBLIC_SUPABASE_URL=https://aqabycljkhftgmiajrot.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_iDh5JFZgoRemJvzIGH78Pg_oeT6WF6l

# Public base URL of the deployment (used in OpenAPI, the A2A agent card, llms.txt and MCP hints).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo agents: "1" (default) shows simulated demo agents flagged is_demo; "0" hides them.
NEXT_PUBLIC_DEMO_AGENTS=1

# Optional. Shared secret for did:key sign-in when Supabase is used. Must equal the value stored in
# the private `server_config` table (key = 'did_login_secret'); see supabase/migrations/0001_init.sql.
# Also used to sign did:key login challenges. Any long random string.
AGENT_SERVER_SECRET=
